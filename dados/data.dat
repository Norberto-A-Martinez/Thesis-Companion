/*
Parâmetros de entrada comum.
*/
param vmin := 0.93; # tensão mínima
param vmax := 1.05; # tensão máxima

# battery & capacitor 
param bat_max := 8;                  # máximo de baterias por nó
param battery_instal_cost := 3000;   # custo de instalação da bateria ($)
param bat_module_capacity := 50;     # kWh   (energia por modulo)
param bat_inverter_capacity := 25;   # kW (potência do inversor)

param man := 0.015;     # taxa de manutenção anual (fracao do CAPEX)

param: B:          life_Cy    life_yr    DoD    Rtef     beta    cosB    cosI    :=
      Li-Ion_LFP   4774.3     18.4       90.0   93.7     0.1     224.1   60.7   # Li-Ion LFP
;

# Horizonte de planejamento
param:Y:    d_Y :=
      5	365
;

# Probabilidade dos cenários
param: S: prob_S:=
      1     0.33
      2     0.33
      3     0.33
;

